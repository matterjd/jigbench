{
  "name": "@jigbench/server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP stdio + HTTP/WS + proxy + drafters. Imports core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-loupe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/dev.ts",
    "test": "vitest run --project server"
  },
  "dependencies": {
    "@jigbench/core": "*",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "open": "^11.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "jsdom": "^30.0.1"
  }
}
