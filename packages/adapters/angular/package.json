{
  "name": "@jigbench/adapter-angular",
  "version": "0.1.0",
  "private": true,
  "description": "SurveyAdapter for Angular — ts-morph over @Component, routes, SCSS/CSS gauges.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project adapter-angular"
  },
  "dependencies": {
    "@jigbench/core": "*",
    "ts-json-schema-generator": "^2.9.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
