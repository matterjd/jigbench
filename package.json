{
  "name": "jigbench-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -k -n server,bench \"npm run dev --workspace=@jigbench/server\" \"npm run dev --workspace=@jigbench/bench\"",
    "check:stdout": "bash scripts/stdout-guard.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
